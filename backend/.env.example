# Banco de dados (PostgreSQL, ex: Neon)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Autenticação do painel admin
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Admin padrão criado no seed
ADMIN_EMAIL="admin@brejolandense.com"
ADMIN_PASSWORD="admin123"

# Servidor
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Notificações push (avisos de gol/início/fim). Gere um par de chaves com:
#   npx web-push generate-vapid-keys
# Sem essas chaves o recurso fica desligado (o site só não mostra o botão).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@exemplo.com"
