# Banco de dados (SQLite para MVP). Para Postgres, troque para:
# DATABASE_URL="postgresql://user:pass@host:5432/brejolandense?schema=public"
DATABASE_URL="file:./dev.db"

# Autenticação do painel admin
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Admin padrão criado no seed
ADMIN_EMAIL="admin@brejolandense.com"
ADMIN_PASSWORD="admin123"

# Servidor
PORT=4000
CORS_ORIGIN="http://localhost:5173"
